# ── Deployment mode ──────────────────────────────────────────
DEPLOYMENT_MODE=cloud

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=fireeyes_dev_secret_change_in_production

# ── Database (Supabase) ──────────────────────────────────────
DATABASE_URL=postgresql://postgres.hxogzpcubetoclfyimkv:gX535aV3XlCFjOJZ@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── AI inference service ────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001

# ── ESP32-CAM ────────────────────────────────────────────────
CAMERA_DISCOVERY_MODE=manual

# ── Alerts ───────────────────────────────────────────────────
ALERT_EMAIL_TO=
ALERT_SMS_TO=

# ── External Notification API (crop-disease-detector backend) ─
# Provides SMS (Termii) + Gmail alerts — no Twilio/SMTP keys needed on our end.
# Fill in the phone/password you registered with on that system, or paste a
# static JWT from /user/auth/login as NOTIFY_API_TOKEN instead.
NOTIFY_API_URL=https://crop-disease-detector-8nqt.onrender.com
NOTIFY_API_PHONE=
NOTIFY_API_PASSWORD=
NOTIFY_API_TOKEN=

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@fireeyes.local

# ── SMS (Twilio) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Sprinkler control ────────────────────────────────────────
SPRINKLER_DEVICE_URL=
SPRINKLER_COOLDOWN_SECONDS=300
ALERT_COOLDOWN_SECONDS=120

# ── Cloud sync ───────────────────────────────────────────────
CLOUD_SYNC_URL=
CLOUD_SYNC_API_KEY=

# ── Phase 2: Crop AI ─────────────────────────────────────────
CROP_TYPE=tomato
CROP_GROWTH_INTERVAL_MINUTES=360
DISEASE_CHECK_INTERVAL_MINUTES=120
DISEASE_ALERT_CONFIDENCE=0.6

# ── Phase 3: Security ────────────────────────────────────────
SECURITY_ALERT_COOLDOWN_SECONDS=120

# ── Phase 3: Irrigation ──────────────────────────────────────
IRRIGATION_DEVICE_URL=
IRRIGATION_CHECK_INTERVAL_MINUTES=30
