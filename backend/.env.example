# ── Deployment mode ──────────────────────────────────────────
# "cloud"  -> centralized, multi-farm, hosted Supabase DB
# "edge"   -> runs on local PC/server at the farm, works offline
DEPLOYMENT_MODE=cloud

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=change_me_in_production

# ── Database (Supabase) ──────────────────────────────────────
# Preferred adapter: Supabase JS client (REST-based, no direct DB connection needed)
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...          # "anon / public" key
SUPABASE_SERVICE_KEY=eyJ...       # "service_role" key (server-side only, bypasses RLS)

# Optional: raw PostgreSQL fallback (requires connection pooler enabled in Supabase)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── AI inference service ─────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001

# ── ESP32-CAM ────────────────────────────────────────────────
CAMERA_DISCOVERY_MODE=manual

# ── Alerts ───────────────────────────────────────────────────
ALERT_EMAIL_TO=
ALERT_SMS_TO=

# ── External Notification API (crop-disease-detector backend) ─
# Provides SMS (Termii) + Gmail alerts via https://crop-disease-detector-8nqt.onrender.com
# Register at the backend, then fill these in:
NOTIFY_API_URL=https://crop-disease-detector-8nqt.onrender.com
NOTIFY_API_PHONE=           # phone number used to register
NOTIFY_API_PASSWORD=        # password used to register
NOTIFY_API_TOKEN=           # or paste a static JWT from /user/auth/login

# ── Email (SMTP fallback) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@agrieyes.local

# ── SMS (Twilio fallback) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Sprinkler control ────────────────────────────────────────
SPRINKLER_DEVICE_URL=
SPRINKLER_COOLDOWN_SECONDS=300
ALERT_COOLDOWN_SECONDS=120

# ── Cloud sync (edge → cloud, only used when DEPLOYMENT_MODE=edge) ──
CLOUD_SYNC_URL=
CLOUD_SYNC_API_KEY=

# ── Phase 2: Crop Growth AI + Plant Disease AI ───────────────
CROP_TYPE=tomato
CROP_GROWTH_INTERVAL_MINUTES=360
DISEASE_CHECK_INTERVAL_MINUTES=120
DISEASE_ALERT_CONFIDENCE=0.6

# ── Phase 3: Farm Security AI ────────────────────────────────
SECURITY_ALERT_COOLDOWN_SECONDS=120

# ── Phase 3: Irrigation ──────────────────────────────────────
IRRIGATION_DEVICE_URL=
IRRIGATION_CHECK_INTERVAL_MINUTES=30
