# ── Deployment mode ──────────────────────────────────────────
# "cloud"  -> centralized, multi-farm, hosted DB
# "edge"   -> runs on local PC/server at the farm, works offline
DEPLOYMENT_MODE=edge

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=change_me_in_production

# ── Database ─────────────────────────────────────────────────
# Cloud mode: point this at Supabase/hosted Postgres
# Edge mode: point this at a local Postgres instance
DATABASE_URL=postgres://fireeyes:fireeyes@localhost:5432/fireeyes_ai

# ── AI inference service ────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001

# ── ESP32-CAM ────────────────────────────────────────────────
# Comma-separated list of camera stream base URLs, or leave blank
# and register cameras dynamically via /api/cameras
CAMERA_DISCOVERY_MODE=manual

# ── Alerts (Phase 1: fire/smoke) ────────────────────────────
ALERT_EMAIL_TO=
ALERT_SMS_TO=

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@fireeyes.local

# ── SMS (Twilio-compatible) ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Sprinkler control ────────────────────────────────────────
# URL of the ESP32 relay controller at the farm. Leave blank to disable
# auto-activation (alerts/notifications still work without it).
SPRINKLER_DEVICE_URL=
# Minimum seconds between sprinkler activations, to avoid flooding the field
# from repeated detections of the same fire.
SPRINKLER_COOLDOWN_SECONDS=300
# Minimum seconds between repeat alerts (email/SMS) for the same camera,
# so a sustained fire doesn't spam your phone every second.
ALERT_COOLDOWN_SECONDS=120

# ── Cloud sync (only used when DEPLOYMENT_MODE=edge) ────────
# If set, edge node pushes events/alerts up to a cloud endpoint
# when internet is available, and queues them when offline.
CLOUD_SYNC_URL=
CLOUD_SYNC_API_KEY=

# ── Phase 2: Crop Growth AI + Plant Disease AI ──────────────
# These run on a schedule against each camera's latest frame, not per-frame
# like fire/smoke — plants don't change second to second.
CROP_TYPE=tomato
CROP_GROWTH_INTERVAL_MINUTES=360
DISEASE_CHECK_INTERVAL_MINUTES=120
DISEASE_ALERT_CONFIDENCE=0.6

# ── Phase 3: Farm Security AI ───────────────────────────────
SECURITY_ALERT_COOLDOWN_SECONDS=120

# ── Phase 3: Irrigation ──────────────────────────────────────
# Points at an ESP32 running pump-relay firmware, separate from the
# fire-suppression sprinkler above. Leave blank to no-op (logs only).
IRRIGATION_DEVICE_URL=
IRRIGATION_CHECK_INTERVAL_MINUTES=30
